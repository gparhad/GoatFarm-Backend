# Copy to .env (never commit it) or set these in your hosting provider's dashboard.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/animaldetective
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
# openssl rand -base64 48
JWT_SECRET=
# Your frontend origin(s), comma separated. Do not leave this as * in production.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
# Optional: Asia/Kolkata etc.
APP_TIME_ZONE=
